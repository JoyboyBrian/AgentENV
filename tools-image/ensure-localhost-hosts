#!/agentenv/bin/busybox sh
# Guarantee that `localhost` resolves through the guest hosts file.
#
# Docker and Kubernetes treat /etc/hosts as a runtime-managed file, so OCI
# images routinely ship it absent, empty, or without loopback entries while
# still assuming `localhost` works. AgentENV boots those images directly as
# Firecracker guests, so this script supplies the equivalent runtime
# behavior: keep every image-provided entry and append only the missing
# IPv4/IPv6 localhost mappings. Re-running it is a no-op, so repeated boots,
# pause/resume cycles, and snapshot restores never duplicate entries.
#
# Path policy:
#   - A symlink to an existing target is preserved; appends follow the link.
#   - Missing files and dangling symlinks become regular 0644 files; any
#     missing parent directories are created under umask 022.
#   - Other non-regular or unwritable paths warn and exit 1; callers treat
#     that as fail-open.
#
# Usage: ensure-localhost-hosts [hosts-file]    (defaults to /etc/hosts)

BB="${BB:-/agentenv/bin/busybox}"
HOSTS_FILE="${1:-/etc/hosts}"

fail_write() {
    echo "AGENTENV PIVOT INIT WARN: failed to write localhost entries to $HOSTS_FILE" >&2
    exit 1
}

# Normalize relative paths once so every applet receives an operand beginning
# with '/', including documented custom paths such as '-hosts'. This avoids
# applet-specific `--` placement and compatibility differences.
case "$HOSTS_FILE" in
    /*) ;;
    *) CURRENT_DIR="$(pwd)" 2>/dev/null || fail_write; HOSTS_FILE="$CURRENT_DIR/$HOSTS_FILE" ;;
esac

# A mapping only counts when `localhost` is a standalone, case-insensitive
# hostname token: bounded by whitespace, not a prefix of a longer name such
# as localhost.localdomain, and not part of a `#` comment.
LOCALHOST_TOKEN='([^#[:space:]]+[[:space:]]+)*localhost([[:space:]]|$)'

# Avoid blocking on FIFOs or silently writing into devices. A symlink to a
# regular file satisfies -f and remains untouched; dangling symlinks reach the
# creation path below.
if [ -e "$HOSTS_FILE" ] && [ ! -f "$HOSTS_FILE" ]; then
    fail_write
fi

if [ ! -e "$HOSTS_FILE" ]; then
    # Missing file or dangling symlink; recreate as a regular file. The
    # parent directory may not exist in FROM scratch images. Apply an explicit
    # umask to both directories and the file so PID 1's inherited umask cannot
    # make /etc or /etc/hosts inaccessible or world-writable.
    "$BB" rm -f "$HOSTS_FILE" 2>/dev/null || fail_write
    case "$HOSTS_FILE" in
        */*) PARENT_DIR="${HOSTS_FILE%/*}"; [ -n "$PARENT_DIR" ] || PARENT_DIR=/ ;;
        *) PARENT_DIR=. ;;
    esac
    (umask 022 && "$BB" mkdir -p "$PARENT_DIR") 2>/dev/null || fail_write
    (umask 022 && : > "$HOSTS_FILE") 2>/dev/null || fail_write
    "$BB" chmod 0644 "$HOSTS_FILE" 2>/dev/null || fail_write
fi

NEED_V4=1
NEED_V6=1
if "$BB" grep -qiE \
    "^[[:space:]]*127\\.0\\.0\\.1[[:space:]]+$LOCALHOST_TOKEN" \
    "$HOSTS_FILE" 2>/dev/null
then
    NEED_V4=0
else
    GREP_STATUS=$?
    [ "$GREP_STATUS" -eq 1 ] || fail_write
fi
if "$BB" grep -qiE \
    "^[[:space:]]*::1[[:space:]]+$LOCALHOST_TOKEN" \
    "$HOSTS_FILE" 2>/dev/null
then
    NEED_V6=0
else
    GREP_STATUS=$?
    [ "$GREP_STATUS" -eq 1 ] || fail_write
fi

# Leave a satisfied file byte-for-byte untouched.
if [ "$NEED_V4" = 0 ] && [ "$NEED_V6" = 0 ]; then
    exit 0
fi

NEED_NEWLINE=0
if [ -s "$HOSTS_FILE" ]; then
    LAST_BYTE="$("$BB" tail -c 1 "$HOSTS_FILE" 2>/dev/null)" || fail_write
    [ -z "$LAST_BYTE" ] || NEED_NEWLINE=1
fi

{
    # Keep appended entries on their own lines even when existing content
    # lacks a trailing newline.
    if [ "$NEED_NEWLINE" = 1 ]; then
        echo
    fi
    if [ "$NEED_V4" = 1 ]; then
        echo "127.0.0.1 localhost"
    fi
    if [ "$NEED_V6" = 1 ]; then
        echo "::1 localhost"
    fi
} 2>/dev/null >> "$HOSTS_FILE" || fail_write

exit 0
